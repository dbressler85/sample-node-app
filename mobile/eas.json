{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dynasty-central-backend.onrender.com",
        "EXPO_PUBLIC_DEVICE_READS": "1",
        "//pro": "Paste the RevenueCat goog_ public key to enable billing; set ENFORCE_PRO to 1 to bite the gates. Unset = dormant. See docs/REVENUECAT_SETUP.md.",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "",
        "EXPO_PUBLIC_ENFORCE_PRO": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dynasty-central-backend.onrender.com",
        "//pro": "Paste the RevenueCat goog_ public key to enable billing; set ENFORCE_PRO to 1 to bite the gates. Unset = dormant. See docs/REVENUECAT_SETUP.md.",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "",
        "EXPO_PUBLIC_ENFORCE_PRO": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
