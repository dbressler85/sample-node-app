{
  "expo": {
    "name": "Dynasty Central",
    "slug": "dynasty-central",
    "owner": "sonicbologna",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "dynastycentral",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#05070E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F8CFF"
        }
      ]
    ],
    "android": {
      "package": "com.dynastycentral.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090F1F"
      },
      "backgroundColor": "#080B15",
      "allowBackup": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_CONTACTS"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dynastycentral.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "//": "Override the backend URL at build/run time with EXPO_PUBLIC_API_URL.",
      "eas": {
        "projectId": "761454da-7a00-442c-93b5-38ddf72a8b77"
      }
    }
  }
}
